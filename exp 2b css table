<!DOCTYPE html>
<html>
<head>
    <title>CSS Table</title>

    <style>
        table {
            width: 50%;
            border-collapse: collapse;
            background-color: lightblue;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
        }

        tr:hover {
            background-color: yellow;
        }
    </style>
</head>

<body>

<table>
    <tr>
        <th>NAME</th>
        <th>AGE</th>
    </tr>

    <tr>
        <td>ANANT</td>
        <td>20</td>
    </tr>

    <tr>
        <td>SIDDHARTH</td>
        <td>22</td>
    </tr>

    <tr>
        <td>ABHISHEK</td>
        <td>21</td>
    </tr>

    <tr>
        <td>RAHUL</td>
        <td>20</td>
    </tr>

    <tr>
        <td>ROHIT</td>
        <td>22</td>
    </tr>

    <tr>
        <td>AMAN</td>
        <td>21</td>
    </tr>

    <tr>
        <td>ARJUN</td>
        <td>20</td>
    </tr>

    <tr>
        <td>VIVEK</td>
        <td>23</td>
    </tr>
</table>

</body>
</html>
