<html>
<head>
    <title>Image CSS</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
        }

                .background {
            width: 100%;
            height: 100vh;

            background-image: url("background.jpg");
            background-size: cover;
            background-position: center;

            position: relative;
        }

                .gallery {
            position: absolute;

            top: 35%;
            left: 5%;
            width: 90%;

            display: flex;
            justify-content: space-between;
        }

        .gallery img {
            width: 30%;
            height: 220px;

            object-fit: cover;

            border: 3px solid white;

            transition: 0.5s;
        }

                .gallery img:hover {
            transform: scale(1.08);
            filter: grayscale(100%) blur(1px);
            border: 3px solid black;
        }

    </style>
</head>

<body>

    <div class="background">

        <div class="gallery">

            <img src="C:\ABHISHEK KR SINGH\image.jpg" alt="Image 1">

            <img src="C:\ABHISHEK KR SINGH\image.jpg" alt="Image 2">

            <img src="C:\ABHISHEK KR SINGH\image.jpg" alt="Image 3">

        </div>

    </div>

</body>
</html>
